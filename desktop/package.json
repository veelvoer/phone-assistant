{
  "name": "phone-assistant-desktop",
  "productName": "Assistant",
  "version": "1.5.6",
  "description": "Claude controls your computer: voice, shell and screen control. Linux (Hyprland/X11/Wayland) and Windows.",
  "main": "src/main.js",
  "author": "veelvoer",
  "license": "MIT",
  "scripts": {
    "start": "electron . --no-sandbox",
    "test": "node test/run.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.0"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "jsdom": "^26.1.0"
  },
  "build": {
    "npmRebuild": false,
    "publish": null,
    "appId": "app.phoneassistant.desktop",
    "productName": "Assistant",
    "files": [
      "src/**",
      "package.json",
      "assets/**"
    ],
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "src/platform/uinput_helper.py",
      "src/platform/windows_helper.ps1"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
